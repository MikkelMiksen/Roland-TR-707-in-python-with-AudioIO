   "cell_type": "code",
   "source": [
    "def highpass(signal, alpha=0.9):\n",
    "    y = np.zeros_like(signal)\n",
    "    for i in range(1, len(signal)):\n",
    "        y[i] = alpha * (y[i-1] + signal[i] - signal[i-1])\n",
    "    return y"
   ],
