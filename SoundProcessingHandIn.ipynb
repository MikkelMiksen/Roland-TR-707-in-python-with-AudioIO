    "def build_beat(events, Fs, seconds_per_beat):\n",
    "    total_beats = sum(beats for _, beats in events)\n",
    "    total_samples = int(total_beats * seconds_per_beat * Fs)\n",
    "\n",
    "    output = np.zeros(total_samples)\n",
    "    cursor = 0\n",
    "\n",
    "    for drum, beats in events:\n",
    "        duration = beats * seconds_per_beat\n",
    "        samples = int(duration * Fs)\n",
    "\n",
    "        if drum == \"kick\":\n",
    "            y = kick_sound(Fs, duration)\n",
    "        elif drum == \"snare\":\n",
    "            y = snare_sound(Fs, duration)\n",
    "        elif drum == \"ch\":\n",
    "            y = hihat_closed(Fs, duration)\n",
    "        elif drum == \"oh\":\n",
    "            y = hihat_open(Fs, duration)\n",
    "        else:\n",
    "            y = np.zeros(samples)\n",
    "\n",
    "        output[cursor:cursor+samples] += y[:samples]\n",
    "        cursor += samples\n",
    "    return output\n",
    "\n",
    "beat = [\n",
    "    kick(0.25), ch(0.25), ch(0.25), ch(0.25),   # 1\n",
    "    snare(0.5), ch(0.5),                        # 2\n",
    "    kick(0.5), ch(0.25), ch(0.25),              # 3\n",
    "    snare(0.5), ch(0.25), ch(0.25),             # 4\n",
    "\n",
    "    kick(0.25), ch(0.25), ch(0.25), ch(0.25),   # 2\n",
    "    snare(0.5), ch(0.5),                        # 2\n",
    "    kick(0.5), ch(0.25), ch(0.25),              # 3\n",
    "    snare(0.5), ch(0.25), ch(0.25),             # 4\n",
    "\n",
    "    kick(0.25), ch(0.25), ch(0.25), ch(0.25),   # 3\n",
    "    snare(0.5), ch(0.5),                        # 2\n",
    "    kick(0.5), ch(0.25), ch(0.25),              # 3\n",
    "    snare(0.5), ch(0.25), ch(0.25),             # 4\n",
    "\n",
    "    kick(0.25), ch(0.25), ch(0.25), ch(0.25),   # 4\n",
    "    snare(0.5), ch(0.5),                        # 2\n",
    "    kick(0.5), ch(0.25), ch(0.25),              # 3\n",
    "    snare(0.5), ch(0.25), ch(0.25),             # 4\n",
    "\n",
    "    kick(0.25), ch(0.25), ch(0.25), ch(0.25),   # 5\n",
    "    snare(0.5), ch(0.5),                        # 2\n",
    "    kick(0.5), ch(0.25), ch(0.25),              # 3\n",
    "    snare(0.5), ch(0.25), ch(0.25),             # 4\n",
    "\n",
    "    kick(0.25), ch(0.25), ch(0.25), ch(0.25),   # 6\n",
    "    snare(0.5), ch(0.5),                        # 2\n",
    "    kick(0.5), ch(0.25), ch(0.25),              # 3\n",
    "    snare(0.5), ch(0.25), ch(0.25),             # 4\n",
    "\n",
